digraph CycleDependencyGraph {
  rankdir=LR;
  node [shape=box, style=filled, fillcolor=lightyellow];
  C0 [label="Cycle 0\nres(5)\n"];
  C1 [label="Cycle 1\na.{bf}(1,5)\n"];
  C2 [label="Cycle 2\nc(5,2)\n"];
  C3 [label="Cycle 3\n@magic.a.{bf}(1)\n"];
  C4 [label="Cycle 4\nb(1,2)\n"];
  C1 -> C0;
  C2 -> C1;
  C4 -> C1;
  C3 -> C1;
}
