# Example environment variables used by repo scripts.
# This repo does not auto-load .env; export them in your shell as needed.

# Path to the Souffle compiler binary used by example scripts.
SOUFFLE_BIN=/path/to/souffle

# Optional compiler flags; examples/running_example/run.sh ensures --online is present.
SOUFFLE_COMPILE_OPTS=--online

# Optional runtime flags passed to compiled binaries.
SOUFFLE_RUN_OPTS=
