// Base facts - nodes in the graph
.decl node(x:number)
.input node

// Base facts - direct edges in the graph
.decl edge(x:number, y:number)
.input edge

// First stratum: Compute transitive closure
.decl path(x:number, y:number)
.output path
path(X,Y) :- edge(X,Y).
path(X,Z) :- path(X,Y), edge(Y,Z).

// Second stratum: Find middle nodes (nodes with paths to and from them
.decl middle(x:number)
.output middle
middle(M) :- node(X), node(Y), path(X,M), path(M,Y).
