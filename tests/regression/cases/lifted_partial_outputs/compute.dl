.decl a(x:symbol)
.input a

.decl dormant(x:symbol, y:symbol)

.decl edge(x:symbol, y:symbol)
.input edge

.decl good(x:symbol)
.output good

.decl bad(x:symbol)
.output bad

good(X) :- a(X).
good(X) :- dormant(X, Y).

// `good(X)` and the direct `a(X)` deliberately share the same probabilistic
// event.  Exact-template composition must inline the complete pointwise
// formula, not its marginal, while grouping the two edge witnesses.
bad(X) :- good(X), a(X), edge(X, Y).
