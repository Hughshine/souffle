.decl a(x:number, y:number)
.input a

.decl b(x:number, y:number)
.output b

.decl c(x:number, y:number)
.output c

.decl res(x:number, y:number)
.output res

0.2::a(1,2).
0.5::a(3,5).
0.7::a(2,3).

0.2::b(X,Y) :- a(X,Y).
0.6::b(X,Y) :- b(X,Z), a(Z,Y).

0.3::c(x,y) :- a(x, y), !b(x,y).

0.7::res(X,Y) :- b(X,Y), c(X,Y).

query(res(_,_)).
