// (define-sort s () (_ BitVec 8))
.type s <: number
// (define-sort BitSet () (_ BitVec 4))
.type BitSet <: number
// (define-sort ind () (_ BitVec 1))
.type ind <: number
// (declare-rel assign (s s))
.decl assign(v0:s,v1:s)
// (declare-rel TDEP (s s))
.decl TDEP(v0:s,v1:s)
// (declare-rel xor_assign_left (s s))
.decl xor_assign_left(v0:s,v1:s)
// (declare-rel xor_assign_right (s s))
.decl xor_assign_right(v0:s,v1:s)
// (declare-rel andor_assign_left (s s))
.decl andor_assign_left(v0:s,v1:s)
// (declare-rel andor_assign_right (s s))
.decl andor_assign_right(v0:s,v1:s)
// (declare-rel not_assign (s s))
.decl not_assign(v0:s,v1:s)
// (declare-rel load_assign (s s))
.decl load_assign(v0:s,v1:s)
// (declare-rel store_assign (s s))
.decl store_assign(v0:s,v1:s)
// (declare-rel zext_assign (s s))
.decl zext_assign(v0:s,v1:s)
// (declare-rel icmp_assign (s s))
.decl icmp_assign(v0:s,v1:s)
// (declare-rel trunc_assign (s s))
.decl trunc_assign(v0:s,v1:s)
// (declare-rel share (s s))
.decl share(v0:s,v1:s)
// (declare-rel binary_constant (s s))
.decl binary_constant(v0:s,v1:s)
// (declare-rel equal_assign (s s))
.decl equal_assign(v0:s,v1:s)
// (declare-rel KEY_SENSITIVE (s))
.decl KEY_SENSITIVE(v0:s)
// (declare-rel KEY_IND (s))
.decl KEY_IND(v0:s)
// (declare-rel CONSTANT (s))
.decl CONSTANT(v0:s)
// (declare-rel RAND (s))
.decl RAND(v0:s)
// (declare-rel HD_SENSITIVE (s s))
.decl HD_SENSITIVE(v0:s,v1:s)
// (declare-rel RAND_NUMBER (ind BitSet))
.decl RAND_NUMBER(v0:ind,v1:BitSet)
// (declare-rel KEY_NUMBER (ind BitSet))
.decl KEY_NUMBER(v0:ind,v1:BitSet)
// (declare-rel REC_RAND_VAR (s ind BitSet))
.decl REC_RAND_VAR(v0:s,v1:ind,v2:BitSet)
// (declare-rel REC_ALL_INC (s ind BitSet))
.decl REC_ALL_INC(v0:s,v1:ind,v2:BitSet)
// (declare-rel Time (ind))
.decl Time(v0:ind)
// (declare-rel BVAND (BitSet BitSet BitSet))
.decl BVAND(v0:BitSet,v1:BitSet,v2:BitSet)
// (declare-rel BVOR (BitSet BitSet BitSet))
.decl BVOR(v0:BitSet,v1:BitSet,v2:BitSet)
// (declare-rel BVNOT (BitSet BitSet))
.decl BVNOT(v0:BitSet,v1:BitSet)
// (declare-rel BV_Intersect (BitSet BitSet BitSet))
.decl BV_Intersect(v0:BitSet,v1:BitSet,v2:BitSet)
// (declare-rel BV_Diff (BitSet BitSet BitSet))
.decl BV_Diff(v0:BitSet,v1:BitSet,v2:BitSet)
// (declare-rel ISEMPTY (BitSet bool))
.decl ISEMPTY(v0:BitSet,v1:bool)
// (declare-rel NOEMPTY (BitSet bool))
.decl NOEMPTY(v0:BitSet,v1:bool)
// (declare-rel SET_SUM (BitSet BitSet BitSet))
.decl SET_SUM(v0:BitSet,v1:BitSet,v2:BitSet)
// (declare-rel XOR_RUD1_ALL_INC (BitSet BitSet BitSet BitSet BitSet BitSet))
.decl XOR_RUD1_ALL_INC(v0:BitSet,v1:BitSet,v2:BitSet,v3:BitSet,v4:BitSet,v5:BitSet)
// (declare-rel BV_EQUAL (BitSet BitSet))
.decl BV_EQUAL(v0:BitSet,v1:BitSet)
// (declare-rel BV_ZERO (BitSet BitSet))
.decl BV_ZERO(v0:BitSet,v1:BitSet)
// (declare-rel BVAND_REC (s s s ind))
.decl BVAND_REC(v0:s,v1:s,v2:s,v3:ind)
// (declare-rel BVAND_ALL_KEY_REC (s ind BitSet))
.decl BVAND_ALL_KEY_REC(v0:s,v1:ind,v2:BitSet)
// (declare-rel BVOR_RAND_REC (s s s ind))
.decl BVOR_RAND_REC(v0:s,v1:s,v2:s,v3:ind)
// (declare-rel BVOR_ALL_REC (s s s ind))
.decl BVOR_ALL_REC(v0:s,v1:s,v2:s,v3:ind)
// (declare-rel BV_INTERSECT_REC (s s ind BitSet))
.decl BV_INTERSECT_REC(v0:s,v1:s,v2:ind,v3:BitSet)
// (declare-rel INTERSECT_LABEL (s s))
.decl INTERSECT_LABEL(v0:s,v1:s)
// (declare-rel BV_DIFF_REC (s s ind BitSet))
.decl BV_DIFF_REC(v0:s,v1:s,v2:ind,v3:BitSet)
// (declare-rel DIFF_LABEL (s s))
.decl DIFF_LABEL(v0:s,v1:s)
// (declare-rel BV_SAME_REC (s s ind BitSet))
.decl BV_SAME_REC(v0:s,v1:s,v2:ind,v3:BitSet)
// (declare-rel CHECK_SAME (s s))
.decl CHECK_SAME(v0:s,v1:s)
// (declare-rel SET_SUM_REC (s s s ind))
.decl SET_SUM_REC(v0:s,v1:s,v2:s,v3:ind)
// (declare-rel XOR_RUD1_ALL_INC_REC (s s s ind))
.decl XOR_RUD1_ALL_INC_REC(v0:s,v1:s,v2:s,v3:ind)
// (declare-rel BV_EQUAL_RAND_REC (s s ind))
.decl BV_EQUAL_RAND_REC(v0:s,v1:s,v2:ind)
// (declare-rel BV_EQUAL_ALL_REC (s s ind))
.decl BV_EQUAL_ALL_REC(v0:s,v1:s,v2:ind)
// (declare-rel BV_ZERO_REC (s s ind))
.decl BV_ZERO_REC(v0:s,v1:s,v2:ind)
// (declare-rel BV_IS_EMPTY_REC (s ind bool))
.decl BV_IS_EMPTY_REC(v0:s,v1:ind,v2:bool)
// (declare-rel q1 (s))
.decl q1(v0:s)
// (rule (=> (and true true) (ISEMPTY X (= X #b0000))))
ISEMPTY(X,=(X,0)).
// (rule (=> (and true true) (SET_SUM X Y (bvor (bvand X (bvnot Y)) (bvand (bvnot X) Y)))))
SET_SUM(X,Y,((X band (bnot (Y))) bor ((bnot (X)) band Y))).
// (rule (=> (and true true) (XOR_RUD1_ALL_INC X_A Y_A X_R Y_R N (bvand (bvor X_A Y_A) (bvor (bvnot N) (bvor (bvand X_R (bvnot Y_R)) (bvand (bvnot X_R) Y_R)))))))
XOR_RUD1_ALL_INC(X_A,Y_A,X_R,Y_R,N,((X_A bor Y_A) band ((bnot (N)) bor ((X_R band (bnot (Y_R))) bor ((bnot (X_R)) band Y_R))))).
// (rule (=> (and (REC_RAND_VAR var_x Times X) (REC_RAND_VAR var_y Times Y) (BVAND_REC var_x var_y var_z Times) (= tmp (bvand X Y))) (REC_RAND_VAR var_z Times tmp)))
REC_RAND_VAR(VAR_Z,TIMES,TMP) :- REC_RAND_VAR(VAR_X,TIMES,X), REC_RAND_VAR(VAR_Y,TIMES,Y), BVAND_REC(VAR_X,VAR_Y,VAR_Z,TIMES), (TMP = (X band Y)).
// (rule (=> (and (REC_RAND_VAR var_x Times X) (REC_RAND_VAR var_y Times Y) (BVOR_RAND_REC var_x var_y var_z Times) (BVOR X Y XY)) (REC_RAND_VAR var_z Times XY)))
REC_RAND_VAR(VAR_Z,TIMES,XY) :- REC_RAND_VAR(VAR_X,TIMES,X), REC_RAND_VAR(VAR_Y,TIMES,Y), BVOR_RAND_REC(VAR_X,VAR_Y,VAR_Z,TIMES), BVOR(X,Y,XY).
// (rule (=> (and (REC_ALL_INC var_x Times X) (REC_ALL_INC var_y Times Y) (BVOR_ALL_REC var_x var_y var_z Times) (BVOR X Y XY)) (REC_ALL_INC var_z Times XY)))
REC_ALL_INC(VAR_Z,TIMES,XY) :- REC_ALL_INC(VAR_X,TIMES,X), REC_ALL_INC(VAR_Y,TIMES,Y), BVOR_ALL_REC(VAR_X,VAR_Y,VAR_Z,TIMES), BVOR(X,Y,XY).
// (rule (=> (and (REC_RAND_VAR var_x Times X) (REC_RAND_VAR var_y Times Y) (SET_SUM_REC var_x var_y var_z Times) (SET_SUM X Y XY)) (REC_RAND_VAR var_z Times XY)))
REC_RAND_VAR(VAR_Z,TIMES,XY) :- REC_RAND_VAR(VAR_X,TIMES,X), REC_RAND_VAR(VAR_Y,TIMES,Y), SET_SUM_REC(VAR_X,VAR_Y,VAR_Z,TIMES), SET_SUM(X,Y,XY).
// (rule (=> (and (SET_SUM_REC var_x var_y var_z Times) (not (= Times_New #b0)) (= Times_New (bvsub Times #b1))) (SET_SUM_REC var_x var_y var_z Times_New)))
SET_SUM_REC(VAR_X,VAR_Y,VAR_Z,TIMES_NEW) :- SET_SUM_REC(VAR_X,VAR_Y,VAR_Z,TIMES), !((TIMES_NEW = 0)), (TIMES_NEW = (TIMES - 1)).
// (rule (=> (and (REC_RAND_VAR var_x Times X_R) (REC_RAND_VAR var_y Times Y_R) (REC_ALL_INC var_x Times X_A) (REC_ALL_INC var_y Times Y_A) (RAND_NUMBER Times RAND_NUM) (XOR_RUD1_ALL_INC X_A Y_A X_R Y_R RAND_NUM XY) (XOR_RUD1_ALL_INC_REC var_x var_y var_z Times)) (REC_ALL_INC var_z Times XY)))
REC_ALL_INC(VAR_Z,TIMES,XY) :- REC_RAND_VAR(VAR_X,TIMES,X_R), REC_RAND_VAR(VAR_Y,TIMES,Y_R), REC_ALL_INC(VAR_X,TIMES,X_A), REC_ALL_INC(VAR_Y,TIMES,Y_A), RAND_NUMBER(TIMES,RAND_NUM), XOR_RUD1_ALL_INC(X_A,Y_A,X_R,Y_R,RAND_NUM,XY), XOR_RUD1_ALL_INC_REC(VAR_X,VAR_Y,VAR_Z,TIMES).
// (rule (=> (and (XOR_RUD1_ALL_INC_REC var_x var_y var_z Times) (= Times_New (bvsub Times #b1)) (not (= Times_New #b0))) (XOR_RUD1_ALL_INC_REC var_x var_y var_z Times_New)))
XOR_RUD1_ALL_INC_REC(VAR_X,VAR_Y,VAR_Z,TIMES_NEW) :- XOR_RUD1_ALL_INC_REC(VAR_X,VAR_Y,VAR_Z,TIMES), (TIMES_NEW = (TIMES - 1)), !((TIMES_NEW = 0)).
// (rule (=> (and (REC_RAND_VAR var_x Times X) (BV_EQUAL_RAND_REC var_x var_y Times)) (REC_RAND_VAR var_y Times X)))
REC_RAND_VAR(VAR_Y,TIMES,X) :- REC_RAND_VAR(VAR_X,TIMES,X), BV_EQUAL_RAND_REC(VAR_X,VAR_Y,TIMES).
// (rule (=> (and (REC_ALL_INC var_x Times X) (BV_EQUAL_ALL_REC var_x var_y Times)) (REC_ALL_INC var_y Times X)))
REC_ALL_INC(VAR_Y,TIMES,X) :- REC_ALL_INC(VAR_X,TIMES,X), BV_EQUAL_ALL_REC(VAR_X,VAR_Y,TIMES).
// (rule (=> (and (REC_RAND_VAR var_x Times X) (BV_ZERO_REC var_x var_y Times) (= XY #b0000)) (REC_RAND_VAR var_y Times XY)))
REC_RAND_VAR(VAR_Y,TIMES,XY) :- REC_RAND_VAR(VAR_X,TIMES,X), BV_ZERO_REC(VAR_X,VAR_Y,TIMES), (XY = 0).
// (rule (=> (assign to from) (TDEP to from)))
TDEP(TO,FROM) :- assign(TO,FROM).
// (rule (=> (load_assign to from) (assign to from)))
assign(TO,FROM) :- load_assign(TO,FROM).
// (rule (=> (store_assign to from) (assign to from)))
assign(TO,FROM) :- store_assign(TO,FROM).
// (rule (=> (and (assign to from) (TDEP from prev)) (TDEP to prev)))
TDEP(TO,PREV) :- assign(TO,FROM), TDEP(FROM,PREV).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (RAND from1)) (DIFF_LABEL from1 from2)))
DIFF_LABEL(FROM1,FROM2) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM1).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (RAND from2)) (DIFF_LABEL from2 from1)))
DIFF_LABEL(FROM2,FROM1) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM2).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (and (RAND from1) (BV_DIFF_REC from1 from2 Times int_res0) (not (= int_res0 #b0000))) (and (RAND from2) (BV_DIFF_REC from2 from1 Times int_res1) (not (= int_res1 #b0000))))) (RAND to)))
RAND(TO) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM1), BV_DIFF_REC(FROM1,FROM2,TIMES,INT_RES0), !((INT_RES0 = 0)).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (and (RAND from1) (BV_DIFF_REC from1 from2 Times int_res0) (not (= int_res0 #b0000))) (and (RAND from2) (BV_DIFF_REC from2 from1 Times int_res1) (not (= int_res1 #b0000))))) (RAND to)))
RAND(TO) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM2), BV_DIFF_REC(FROM2,FROM1,TIMES,INT_RES1), !((INT_RES1 = 0)).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (and (and (RAND from1) (BV_DIFF_REC from1 from2 Times int_res0) (= int_res0 #b0000)) (and (RAND from2) (BV_DIFF_REC from2 from1 Times int_res1) (= int_res1 #b0000)))) (CHECK_SAME from1 from2)))
CHECK_SAME(FROM1,FROM2) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM1), BV_DIFF_REC(FROM1,FROM2,TIMES,INT_RES0), (INT_RES0 = 0), RAND(FROM2), BV_DIFF_REC(FROM2,FROM1,TIMES,INT_RES1), (INT_RES1 = 0).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (RAND from1) (RAND from2)) (BV_SAME_REC from1 from2 Times int_res0) (= int_res0 #b0000)) (KEY_IND to)))
KEY_IND(TO) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM1), BV_SAME_REC(FROM1,FROM2,TIMES,INT_RES0), (INT_RES0 = 0).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (RAND from1) (RAND from2)) (BV_SAME_REC from1 from2 Times int_res0) (= int_res0 #b0000)) (KEY_IND to)))
KEY_IND(TO) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM2), BV_SAME_REC(FROM1,FROM2,TIMES,INT_RES0), (INT_RES0 = 0).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (RAND from1) (RAND from2)) (BV_SAME_REC from1 from2 Times int_res0) (not (= int_res0 #b0000))) (KEY_SENSITIVE to)))
KEY_SENSITIVE(TO) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM1), BV_SAME_REC(FROM1,FROM2,TIMES,INT_RES0), !((INT_RES0 = 0)).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (RAND from1) (RAND from2)) (BV_SAME_REC from1 from2 Times int_res0) (not (= int_res0 #b0000))) (KEY_SENSITIVE to)))
KEY_SENSITIVE(TO) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM2), BV_SAME_REC(FROM1,FROM2,TIMES,INT_RES0), !((INT_RES0 = 0)).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (and (RAND from1) (BV_DIFF_REC from1 from2 Times int_res0) (not (= int_res0 #b0000))) (and (RAND from2) (BV_DIFF_REC from2 from1 Times int_res1) (not (= int_res1 #b0000))))) (SET_SUM_REC from1 from2 to Times)))
SET_SUM_REC(FROM1,FROM2,TO,TIMES) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM1), BV_DIFF_REC(FROM1,FROM2,TIMES,INT_RES0), !((INT_RES0 = 0)).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (and (RAND from1) (BV_DIFF_REC from1 from2 Times int_res0) (not (= int_res0 #b0000))) (and (RAND from2) (BV_DIFF_REC from2 from1 Times int_res1) (not (= int_res1 #b0000))))) (SET_SUM_REC from1 from2 to Times)))
SET_SUM_REC(FROM1,FROM2,TO,TIMES) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM2), BV_DIFF_REC(FROM2,FROM1,TIMES,INT_RES1), !((INT_RES1 = 0)).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (RAND from1) (RAND from2))) (XOR_RUD1_ALL_INC_REC from1 from2 to Times)))
XOR_RUD1_ALL_INC_REC(FROM1,FROM2,TO,TIMES) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM1).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (Time Times) (or (RAND from1) (RAND from2))) (XOR_RUD1_ALL_INC_REC from1 from2 to Times)))
XOR_RUD1_ALL_INC_REC(FROM1,FROM2,TO,TIMES) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), Time(TIMES), RAND(FROM2).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (KEY_SENSITIVE from1) (KEY_SENSITIVE from2)) (KEY_SENSITIVE to)))
KEY_SENSITIVE(TO) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), KEY_SENSITIVE(FROM1), KEY_SENSITIVE(FROM2).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (KEY_IND from1) (KEY_IND from2)) (INTERSECT_LABEL from1 from2)))
INTERSECT_LABEL(FROM1,FROM2) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), KEY_IND(FROM1), KEY_IND(FROM2).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (KEY_IND from1) (KEY_IND from2) (Time Times) (BV_INTERSECT_REC from1 from2 Times int_res0) (= int_res0 #b0000)) (KEY_IND to)))
KEY_IND(TO) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), KEY_IND(FROM1), KEY_IND(FROM2), Time(TIMES), BV_INTERSECT_REC(FROM1,FROM2,TIMES,INT_RES0), (INT_RES0 = 0).
// (rule (=> (and (xor_assign_left to from1) (xor_assign_right to from2) (KEY_IND from1) (KEY_IND from2) (Time Times) (BV_INTERSECT_REC from1 from2 Times int_res0) (not (= int_res0 #b0000))) (KEY_SENSITIVE to)))
KEY_SENSITIVE(TO) :- xor_assign_left(TO,FROM1), xor_assign_right(TO,FROM2), KEY_IND(FROM1), KEY_IND(FROM2), Time(TIMES), BV_INTERSECT_REC(FROM1,FROM2,TIMES,INT_RES0), !((INT_RES0 = 0)).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (RAND from1) (or (KEY_IND from2) (RAND from2))) (INTERSECT_LABEL from1 from2)))
INTERSECT_LABEL(FROM1,FROM2) :- andor_assign_left(TO,FROM1), andor_assign_right(TO,FROM2), RAND(FROM1), KEY_IND(FROM2).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (RAND from1) (or (KEY_IND from2) (RAND from2))) (INTERSECT_LABEL from1 from2)))
INTERSECT_LABEL(FROM1,FROM2) :- andor_assign_left(TO,FROM1), andor_assign_right(TO,FROM2), RAND(FROM1), RAND(FROM2).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (RAND from1) (or (KEY_IND from2) (RAND from2)) (Time Times) (BV_INTERSECT_REC from1 from2 Times int_res0) (= int_res0 #b0000)) (KEY_IND to)))
KEY_IND(TO) :- andor_assign_left(TO,FROM1), andor_assign_right(TO,FROM2), RAND(FROM1), KEY_IND(FROM2), Time(TIMES), BV_INTERSECT_REC(FROM1,FROM2,TIMES,INT_RES0), (INT_RES0 = 0).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (RAND from1) (or (KEY_IND from2) (RAND from2)) (Time Times) (BV_INTERSECT_REC from1 from2 Times int_res0) (= int_res0 #b0000)) (KEY_IND to)))
KEY_IND(TO) :- andor_assign_left(TO,FROM1), andor_assign_right(TO,FROM2), RAND(FROM1), RAND(FROM2), Time(TIMES), BV_INTERSECT_REC(FROM1,FROM2,TIMES,INT_RES0), (INT_RES0 = 0).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (RAND from1) (or (KEY_IND from2) (RAND from2)) (Time Times) (BV_INTERSECT_REC from1 from2 Times int_res0) (not (= int_res0 #b0000))) (KEY_SENSITIVE to)))
KEY_SENSITIVE(TO) :- andor_assign_left(TO,FROM1), andor_assign_right(TO,FROM2), RAND(FROM1), KEY_IND(FROM2), Time(TIMES), BV_INTERSECT_REC(FROM1,FROM2,TIMES,INT_RES0), !((INT_RES0 = 0)).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (RAND from1) (or (KEY_IND from2) (RAND from2)) (Time Times) (BV_INTERSECT_REC from1 from2 Times int_res0) (not (= int_res0 #b0000))) (KEY_SENSITIVE to)))
KEY_SENSITIVE(TO) :- andor_assign_left(TO,FROM1), andor_assign_right(TO,FROM2), RAND(FROM1), RAND(FROM2), Time(TIMES), BV_INTERSECT_REC(FROM1,FROM2,TIMES,INT_RES0), !((INT_RES0 = 0)).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (KEY_SENSITIVE from2) (RAND from1)) (KEY_SENSITIVE to)))
KEY_SENSITIVE(TO) :- andor_assign_left(TO,FROM1), andor_assign_right(TO,FROM2), KEY_SENSITIVE(FROM2), RAND(FROM1).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (RAND from2) (or (KEY_IND from1) (RAND from1))) (INTERSECT_LABEL from1 from2)))
INTERSECT_LABEL(FROM1,FROM2) :- andor_assign_left(TO,FROM1), andor_assign_right(TO,FROM2), RAND(FROM2), KEY_IND(FROM1).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (RAND from2) (or (KEY_IND from1) (RAND from1))) (INTERSECT_LABEL from1 from2)))
INTERSECT_LABEL(FROM1,FROM2) :- andor_assign_left(TO,FROM1), andor_assign_right(TO,FROM2), RAND(FROM2), RAND(FROM1).
// (rule (=> (and (andor_assign_left to from1) (andor_assign_right to from2) (or (KEY_IND from1) (RAND from1)) (RAND from2) (Time Times) (BV_INTERSECT_REC from1 from2 Times int_res0) (= int_res0 #b0000)) (KEY_IND to)))
