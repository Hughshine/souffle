// Stratum 1
.decl I(x:number, y:number)
.input I

.decl A(x:number, y:number)
A(x,y) :- I(x,y).

// Stratum 2
.decl B(x:number, y:number)
B(x,y) :- I(x,z), A(z,y).

// Stratum 3
.decl C(x:number, y:number)
C(x,y) :- B(x,z), A(z,y).

// Stratum 4
.decl D(x:number, y:number)
D(x,y) :- C(x,z), A(z,y).

.output A
.output B
.output C
.output D