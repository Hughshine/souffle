share(6, 8).
share(7, 8).
RAND(1).
RAND(2).
KEY_SENSITIVE(3).
load_assign(52, 3).
load_assign(53, 2).
xor_assign_left(54, 52).
xor_assign_right(54, 53).
BV_DIFF_REC(53, 52, 1).
store_assign(9, 54).
load_assign(17, 1).
load_assign(18, 2).
xor_assign_left(19, 17).
xor_assign_right(19, 18).
BV_DIFF_REC(17, 18, 1).
store_assign(4, 19).
load_assign(21, 1).
load_assign(22, 9).
xor_assign_left(23, 21).
xor_assign_right(23, 22).
BV_DIFF_REC(21, 22, 1).
store_assign(5, 23).
load_assign(25, 5).
load_assign(65, 4).
xor_assign_left(66, 25).
xor_assign_right(66, 65).
BV_DIFF_REC(65, 25, 0).
BV_DIFF_REC(25, 65, 0).
BV_SAME_REC(25, 65, 1).
store_assign(6, 66).
load_assign(68, 6).
load_assign(69, 1).
xor_assign_left(70, 68).
xor_assign_right(70, 69).
BV_DIFF_REC(69, 68, 1).
store_assign(7, 70).
load_assign(33, 7).
load_assign(34, 1).
xor_assign_left(35, 33).
xor_assign_right(35, 34).
BV_DIFF_REC(34, 33, 0).
BV_DIFF_REC(33, 34, 0).
BV_SAME_REC(33, 34, 1).
store_assign(8, 35).
load_assign(37, 8).

.output KEY_IND
.output KEY_SENSITIVE
.output RAND